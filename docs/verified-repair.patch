+    def _aggregate_metric(self, arguments: dict[str, Any]) -> dict[str, Any]:
+        allowed = {"metric", "group_by", "filter_field", "filter_value"}
+        if not isinstance(arguments, dict) or set(arguments) - allowed:
+            raise ToolError("Unsupported aggregate_metric argument")
+        metric = arguments.get("metric")
+        if metric not in self.config.metrics:
+            raise ToolError("aggregate_metric requires a supported metric")
+        group_by = arguments.get("group_by")
+        if group_by is not None and group_by not in self.config.group_fields:
+            raise ToolError("aggregate_metric group_by is unsupported")
+        filter_field = arguments.get("filter_field")
+        filter_value = arguments.get("filter_value")
+        if (filter_field is None) != (filter_value is None):
+            raise ToolError("filter_field and filter_value must be provided together, or both omitted")
+        if filter_field is not None and (filter_field not in self.config.filter_fields or not isinstance(filter_value, str)):
+            raise ToolError("aggregate_metric filter is unsupported")
+
+        base_kwargs: dict[str, Any] = {"limit": self.config.limits.max_page_size}
+        if filter_field is not None:
+            base_kwargs["filter_field"] = filter_field
+            base_kwargs["filter_value"] = filter_value
+
+        scalar_total = 0
+        grouped_totals: dict[str, int] = {}
+        cursor: str | None = None
+        for _ in range(self.config.limits.max_pages):
+            kwargs = dict(base_kwargs)
+            if cursor is not None:
+                kwargs["cursor"] = cursor
+            page = self.table.read_rows(**kwargs)
+            if self.table.bytes_read > self.config.limits.max_bytes:
+                raise ToolError("aggregate_metric exceeded the byte budget")
+            for row in page["rows"]:
+                value = row["on_hand"] - row["reserved"] if metric == "available" else row[metric]
+                if group_by is not None:
+                    key = row[group_by]
+                    grouped_totals[key] = grouped_totals.get(key, 0) + value
+                else:
+                    scalar_total += value
+            cursor = page["next_cursor"]
+            if cursor is None:
+                if group_by is not None:
+                    return {"groups": {key: grouped_totals[key] for key in sorted(grouped_totals)}}
+                return {"value": scalar_total}
+        raise ToolError("aggregate_metric exceeded the page budget")
