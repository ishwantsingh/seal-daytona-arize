# Local database (created automatically)
SEAL_DATABASE_PATH=.seal/seal.sqlite3

# Models, accessed only by the supervisor
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=
OPENROUTER_EVOLUTION_MODEL=

# Daytona candidate execution
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=seal-python311-v1
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# Arize Phoenix Cloud: use your app URL, INCLUDING /s/<handle>.
# Local Phoenix: use http://localhost:6006 for both URLs.
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/YOUR_APP_HANDLE
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/YOUR_APP_HANDLE/v1/traces
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=seal
PHOENIX_TRACING=true
